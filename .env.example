# Discord Voice Bot Environment Configuration

# Your Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# The server (guild) ID (required)
GUILD_ID=your_guild_id_here

# The voice or stage channel to stay in (required)
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Join deafened (set to "false" to disable) (optional)
SELF_DEAF=true

# Join muted (set to "true" to enable) (optional)
SELF_MUTE=false
